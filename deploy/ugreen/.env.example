TZ=America/New_York

# Replace with actual UGREEN absolute paths.
APPDATA_ROOT=/volume1/docker/el-jeffe
VIDEO_ROOT=/volume1/Media/Video
MUSIC_ROOT=/volume1/Media/Music
AUDIOBOOKS_ROOT=/volume1/Media/Audiobooks
PODCASTS_ROOT=/volume1/Media/Podcasts
BOOKS_ROOT=/volume1/Media/Books
MAGAZINES_ROOT=/volume1/Media/Magazines
COMICS_ROOT=/volume1/Media/Comics

PUID=1000
PGID=1000

# Generate with: openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Example: 192.168.1.0/24
LAN_SUBNET=192.168.1.0/24

# Fill from your own VPN provider.
VPN_SERVICE_PROVIDER=REPLACE_ME
VPN_TYPE=wireguard
VPN_SERVER_COUNTRIES=United States
OPENVPN_USER=
OPENVPN_PASSWORD=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Optional Cloudflare Tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=
