TZ=America/New_York
NAS_NAME=ELJEFFETV
NAS_IP=192.168.1.222

# The installer tries to discover these recorded shares under /volume*.
# Recorded movie/TV share: PLEX_2/Media/Movies and TV Shows
# Recorded music share: MUSIC
# Recorded ROM share: roms
#
# If auto-discovery cannot resolve them, replace the paths below manually.
APPDATA_ROOT="/volume1/docker/el-jeffe"
VIDEO_ROOT="/volume1/PLEX_2/Media/Movies and TV Shows"
MUSIC_ROOT="/volume1/MUSIC"
AUDIOBOOKS_ROOT="/volume1/Audiobooks"
PODCASTS_ROOT="/volume1/Podcasts"
BOOKS_ROOT="/volume1/Books"
MAGAZINES_ROOT="/volume1/Magazines"
COMICS_ROOT="/volume1/Comics"
ROMS_ROOT="/volume1/roms"

# install-ugreen.sh automatically generates this when it is still the placeholder.
HOMARR_SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Change if your LAN uses a different subnet.
LAN_SUBNET=192.168.1.0/24

# Fill these only for the Gluetun "vpn" / "iptv-vpn" profiles.
VPN_SERVICE_PROVIDER=REPLACE_ME
VPN_TYPE=wireguard
VPN_SERVER_COUNTRIES="United States"
OPENVPN_USER=
OPENVPN_PASSWORD=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Fill this only for the Cloudflare Tunnel "remote" profile.
CLOUDFLARE_TUNNEL_TOKEN=
